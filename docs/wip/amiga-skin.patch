-/* Spaceward Ho! — Amiga 2.0 skin: the DOS skin's layout with the Amiga
-   version's pictures, in Workbench 2 colours. Its windows, menus and
-   controls are the "Workbench" OS look (js/os/workbench.css). */
+/* Spaceward Ho! — Amiga 2.0 skin: the Amiga version's own screen, drawn
+   as the screenshots show it (docs/amiga-skin.md), on the classic page
+   (js/skins/amiga/ui.js lays it out). Every size is in Amiga pixels:
+   --u across and --v down are the CSS pixels one takes (ui.js sets them:
+   tall pixels, --v = 2 --u, or square). The windows' chrome is drawn here
+   for the Workbench look (html.os-workbench); in any other OS look the
+   windows keep that look's. The classic and DOS skins' rules come first. */
 @import url("../dos/style.css");
-:root { --hat: #0055aa; --west: Verdana, Arial, sans-serif; }
-.box h3 { color: #0055aa; }
-.fill { background: #0055aa; }
-.card { background: #aaaaaa; border-top-color: #6688bb; }
-.frow.sel { border-color: #0055aa; }
